{
  "name": "kelvin-zero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KELVIN ZERO — A gallery of computed phenomena. WebGL2 immersive gallery.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/router.test.mjs tests/static.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "ci": "npm run typecheck && npm test && npm run build && npm run verify:build && npm run test:browser"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
